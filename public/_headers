# This file is the ONLY place security headers are configured.
#
# script-src needs 'wasm-unsafe-eval': on a static host @nuxt/content runs its
# queries in the browser against @sqlite.org/sqlite-wasm, and compiling that
# module counts as script evaluation. Without it every client-side
# queryCollection fails (⌘K search, client-side navigation to a docs page)
# while the prerendered first paint still looks correct.
#
# Umami analytics serves script.js and receives its /api/send beacons from the
# same origin, cloud.umami.is, so that host has to appear in BOTH script-src and
# connect-src. Naming it only in script-src lets the tag load and then silently
# drops every measurement.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), fullscreen=(self), geolocation=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self' https://api.rux-lang.dev https://cloud.umami.is https://cloudflareinsights.com; font-src 'self' data:; frame-ancestors 'none'; img-src 'self' data: https://avatars.githubusercontent.com; object-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests; worker-src 'self' blob:

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The nitro route sets this itself, but the route is prerendered away — what
# ships is a plain .xml file, which Cloudflare would otherwise serve as
# application/xml. Readers accept that; the specific type is what makes browser
# feed extensions offer to subscribe.
/blog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
