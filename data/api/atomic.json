      "typeParams": [{ "name": "T", "bounds": [] }],
      "doc": {
        "summary": "One value that threads read and change without a lock.",
        "markdown": "One value that threads read and change without a lock.\n`T` must be an integer of 8 to 64 bits, `bool` or a pointer; any other type is refused where the methods are used.\nShared by reference between threads; the value lives inside, so it must outlive every thread that reaches it.\nCopying an `Atomic` copies its current value into a new, unrelated one.",
        "typeParams": [
          { "name": "T", "markdown": "the value's type: an integer of 8 to 64 bits, `bool`, or a pointer" }
        ],
