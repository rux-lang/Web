      "name": "Measure",
      "displayName": "Measure",
      "module": "Benchmark",
      "source": "Src/Benchmark.rux",
      "line": 87,
      "signature": "pub func Measure(run: func(uint64), options: BenchmarkOptions) -> BenchmarkResult",
      "typeParams": [],
      "doc": {
        "summary": "Runs `run` with a growing iteration count until one run lasts at least `options.minimumTime` or reaches\n`options.maximumIterations`, and reports that run.",
        "markdown": "Runs `run` with a growing iteration count until one run lasts at least `options.minimumTime` or reaches\n`options.maximumIterations`, and reports that run.\nEach next count aims a little past the minimum from the rate measured so far, growing at least twofold and at\nmost a hundredfold, so a measurement makes few runs whatever the work costs.",
        "typeParams": [],
        "params": [
          { "name": "run", "markdown": "the work, repeated as many times as it is told" },
          { "name": "options", "markdown": "how long to measure" }
        ],
        "returns": "the final run's iterations and time",
        "see": ["https://rux-lang.dev/docs/api/test/benchmark#measure"],
        "deprecated": null
