      "line": 100,
      "signature": "pub func RunTestsWith(tests: TestCase[..], options: TestOptions) -> int",
      "typeParams": [],
      "doc": {
        "summary": "Runs the tests that `options` choose, in order, and reports each as `ok`, `FAILED` with its message, or\n`skipped` with its reason, then a summary of the counts and the time taken.",
        "markdown": "Runs the tests that `options` choose, in order, and reports each as `ok`, `FAILED` with its message, or\n`skipped` with its reason, then a summary of the counts and the time taken. A filter that chooses no test at all is\nreported as `no test matches` and given a code of its own, so that `rux test`, which hands one filter to every\npackage, can fail the run when no package had a test it matched instead of passing with nothing run.",
        "typeParams": [],
        "params": [
          { "name": "tests", "markdown": "the tests" },
          { "name": "options", "markdown": "which to run and how to report them" }
        ],
        "returns": "0 when none failed, 1 when some did, 3 when filters chose no test",
        "see": ["https://rux-lang.dev/docs/api/test/runner#run-tests-with"],
        "deprecated": null
      },
