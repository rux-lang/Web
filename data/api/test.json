      "signature": "pub func RunTests(tests: TestCase[..]) -> int",
      "typeParams": [],
      "doc": {
        "summary": "Runs the tests the process's arguments choose.",
        "markdown": "Runs the tests the process's arguments choose. A plain argument is a filter that a test's name must hold, and a\ntest runs when its name holds any of them; `--exact` makes each the whole name, `--skip <text>` leaves out names\nholding the text, `--list` lists the chosen tests without running them, and `--quiet` reports only failures and\nthe summary.",
        "typeParams": [],
        "params": [{ "name": "tests", "markdown": "the tests" }],
        "returns": "0 when none failed, 1 when some did, 2 for arguments it does not understand, 3 when filters chose no\ntest",
        "see": ["https://rux-lang.dev/docs/api/test/runner#run-tests"],
        "deprecated": null
